    "nasa_power": {
      "id": "nasa_power",
      "name": "NASA Prediction Of Worldwide Energy Resources (POWER)",
      "provider": "NASA Langley Research Center (LaRC)",
      "endpoint": "https://power.larc.nasa.gov/api/temporal/daily/point",
      "format": "JSON / CSV",
      "authRequired": false,
      "dataType": "Modeled / Assimilated (MERRA-2 & GEOS FP-IT)",
      "spatialResolution": "0.5° x 0.625° (~50km)",
      "temporalResolution": "Daily",
      "parameters": [
        {
          "code": "PRECTOTCORR",
          "name": "Precipitation Corrected",
          "unit": "mm/day",
          "convertedUnit": "inches/day"
        },
        {
          "code": "T2M",
          "name": "Temperature at 2 Meters",
          "unit": "°C",
          "convertedUnit": "°F"
        },
        {
          "code": "T2M_MAX",
          "name": "Maximum Temperature at 2 Meters",
          "unit": "°C",
          "convertedUnit": "°F"
        },
        {
          "code": "T2M_MIN",
          "name": "Minimum Temperature at 2 Meters",
          "unit": "°C",
          "convertedUnit": "°F"
        },
        {
          "code": "RH2M",
          "name": "Relative Humidity at 2 Meters",
          "unit": "%",
          "convertedUnit": "%"
        },
        {
          "code": "ALLSKY_SFC_SW_DWN",
          "name": "All Sky Surface Shortwave Downward Irradiance",
          "unit": "MJ/m^2/day",
          "convertedUnit": "MJ/m^2/day"
        },
        {
          "code": "WS2M",
          "name": "Wind Speed at 2 Meters",
          "unit": "m/s",
          "convertedUnit": "mph"
        },
        {
          "code": "GWETROOT",
          "name": "Root Zone Soil Wetness (0-1)",
          "unit": "dimensionless",
          "convertedUnit": "% saturation"
        },
        {
          "code": "GWETTOP",
          "name": "Surface Soil Wetness (0-1)",
          "unit": "dimensionless",
          "convertedUnit": "% saturation"
        }
      ],
      "officialUrl": "https://power.larc.nasa.gov/"
    },
