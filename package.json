{
  "name": "nilam-pesum",
  "version": "1.0.0",
  "description": "Nilam Pesum (FieldVoice) - AI-powered, voice-first agricultural decision-support platform for NASA Space Apps Challenge 2026",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "refresh-data": "node server/scripts/refreshData.js",
    "test": "node server/tests/runTests.js"
  },
  "keywords": [
    "nasa",
    "space-apps",
    "agriculture",
    "crop-rotation",
    "earth-observation",
    "voice-ai"
  ],
  "author": "Nilam Pesum Team",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
